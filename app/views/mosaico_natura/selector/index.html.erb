<div class="container mt-5 mb-5">
  <% if @foto.present? %>
    <h2>Categoría: <%= @foto&.categoria&.nombre_categoria %></h2>

    <p>Revisadas: <strong><%= @revisadas %></strong> de <strong><%= @total %></strong></p>
    <p>Seleccionadas: <strong><%= @seleccionadas %></strong></p>
    <p>Descartadas: <strong><%= @descartadas %></strong></p>

    <div class="text-center">
      <%= image_tag @foto.original_filename.url, style: "max-width:900px; max-height:650px;" %>

      <br><br>

      <%= form_with url: mosaico_natura_selector_path(@foto), method: :patch, local: true do %>
        <div class="d-flex justify-content-center flex-wrap gap-2">

          <%= link_to "⬇ Descargar original",
                      @foto.original_filename.url,
                      target: "_blank",
                      class: "btn btn-info btn-lg mr-3 mb-2" %>

          <%= link_to "🖼 Galería",
                      gallery_mosaico_natura_selector_index_path,
                      class: "btn btn-primary btn-lg mr-3 mb-2" %>

          <%= link_to "📊 Exportar participantes",
                      reporte_mosaico_natura_selector_index_path(format: :xlsx),
                      class: "btn btn-warning btn-lg mr-3 mb-2" %>

          <button type="submit"
                  name="selected"
                  value="false"
                  class="btn btn-danger btn-lg mr-3 mb-2">
            ❌ Descartar
          </button>

          <button type="submit"
                  name="selected"
                  value="true"
                  class="btn btn-success btn-lg mr-3 mb-2">
            ✅ Seleccionar
          </button>

        </div>
      <% end %>
    </div>

  <% else %>

    <div class="text-center mb-3 mt-5" >
      <%= link_to "🖼 Galería",
                  gallery_mosaico_natura_selector_index_path,
                  class: "btn btn-primary btn-lg mr-3 mb-2 mt-4" %>

      <%= link_to "📊 Exportar participantes",
            reporte_mosaico_natura_selector_index_path(format: :xlsx),
            id: "btn-exportar",
            class: "btn btn-warning btn-lg mr-3 mb-2 mt-4" %>

    </div>

    <div class="alert alert-success">
      <h3>✔ No hay fotografías pendientes por revisar.</h3>
    </div>

  <% end %>
</div>

<script>

document.addEventListener("DOMContentLoaded", function () {
  var boton = document.getElementById("btn-exportar");

  if (boton) {
    boton.addEventListener("click", function () {
      document.getElementById("loading-export").style.display = "block";

      setTimeout(function () {
        document.getElementById("loading-export").style.display = "none";
      }, 12000);
    });
  }
});
</script>

<div id="loading-export"
     style="display:none;
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:rgba(255,255,255,.8);
            z-index:9999;">

  <div style="position:absolute;
              top:50%;
              left:50%;
              transform:translate(-50%,-50%);
              text-align:center;">
    <div class="spinner-border text-primary" role="status"></div>
    <h4 class="mt-3">Generando reporte...</h4>
    <p>Esto puede tardar unos segundos.</p>
  </div>
</div>