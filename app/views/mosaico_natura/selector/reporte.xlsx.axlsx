wb = xlsx_package.workbook

styles = wb.styles

header = styles.add_style(
  b: true,
  bg_color: "4F81BD",
  fg_color: "FFFFFF"
)

wb.add_worksheet(name: "Participantes") do |sheet|

  sheet.add_row [
    "ID Foto",
    "Nombre",
    "Edad",
    "Correo electrónico",
    "Lugar de origen",
    "Lugar donde tomó la foto",
    "Categoría",
    "Título de la foto",
    "Descripción",
    "Cómo se enteró"
  ], style: header

  @medias.each do |media|
    usuario = media.usuario
    next unless usuario

    metadato = media.media_metadato

    medio =
      if usuario.medio == "otro"
        usuario.otro_medio
      else
        MosaicoNatura::UsuarioMn::MEDIO
          .detect { |m| m[1] == usuario.medio }
          &.first
      end

    sheet.add_row [
      media.id,
      [
        usuario.nombre,
        usuario.apellido_paterno,
        usuario.apellido_materno
      ].compact.join(" "),
      media.edad,
      usuario.user&.email,
      usuario.lugar_nacimiento,
      metadato&.localidad,
      media.categoria&.nombre_categoria,
      metadato&.titulo,
      metadato&.descripcion,
      medio
    ]
  end

end