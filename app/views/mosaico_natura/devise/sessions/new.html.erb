<div id="inscripcion" class="signup-section py-5">
  <%= render partial: "mosaico_natura/shared/sub-header",
             locals: { title: "Inicia sesión" } %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-6">

```
    <div class="signup-card">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-3">Bienvenido de nuevo</h2>

        <p class="text-light opacity-75 mb-0">
          Accede a tu cuenta para continuar con tu participación en el concurso.
        </p>
      </div>

      <%= simple_form_for(resource,
                          as: resource_name,
                          url: session_path(resource_name)) do |f| %>

        <div class="form-inputs">

          <%= f.input :email,
                      required: false,
                      autofocus: true,
                      label: "Correo electrónico",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "email"
                      } %>

          <%= f.input :password,
                      required: false,
                      label: "Contraseña",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "current-password"
                      } %>

          <% if devise_mapping.rememberable? %>
            <div class="terms-card mt-3 mb-4">
              <%= f.input :remember_me,
                          as: :boolean,
                          label: "Mantener sesión iniciada" %>
            </div>
          <% end %>

        </div>

        <div class="form-actions">
          <%= f.button :submit,
                       "Iniciar sesión",
                       class: "btn btn-success btn-lg w-100 shadow-sm" %>
        </div>

      <% end %>

      <hr class="border-secondary my-4">

      <div class="text-center">
        <%= render "mosaico_natura/devise/shared/links" %>
      </div>

    </div>

  </div>
</div>
