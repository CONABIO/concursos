<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:30px 0;font-family:Arial,Helvetica,sans-serif;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">
    <tr>
      <td style="background:#2d6a4f;padding:25px;text-align:center;color:#ffffff;">
        <h1 style="margin:0;font-size:24px;">Mosaico Natura</h1>
      </td>
    </tr>
    <tr>
      <td style="padding:40px;color:#333333;">
        <h2 style="margin-top:0;color:#2d6a4f;">Hola <%= @email %></h2>

        <% if @resource.try(:unconfirmed_email?) %>
          <p style="font-size:16px;line-height:1.6;">
            Te informamos que se ha solicitado cambiar tu correo electrónico.
          </p>

          <div style="background:#f8f9fa;border-left:4px solid #2d6a4f;padding:15px;margin:20px 0;">
            <strong>Nuevo correo:</strong><br>
            <%= @resource.unconfirmed_email %>
          </div>
        <% else %>
          <p style="font-size:16px;line-height:1.6;">
            Te informamos que tu dirección de correo electrónico ha sido actualizada correctamente.
          </p>

          <div style="background:#f8f9fa;border-left:4px solid #2d6a4f;padding:15px;margin:20px 0;">
            <strong>Correo actual:</strong><br>
            <%= @resource.email %>
          </div>
        <% end %>

        <p style="font-size:16px;line-height:1.6;">
          Si realizaste este cambio, no es necesario realizar ninguna acción adicional.
        </p>

        <p style="font-size:16px;line-height:1.6;color:#c0392b;">
          Si no reconoces este cambio, te recomendamos contactar al administrador del sistema lo antes posible.
        </p>
      </td>
    </tr>

    <tr>
      <td style="background:#f8f9fa;padding:20px;text-align:center;color:#777777;font-size:12px;">
        © <%= Time.current.year %> Mosaico Natura<br>
        Este es un mensaje automático, por favor no respondas a este correo.
      </td>
    </tr>

  </table>
</td>
  </tr>
</table>

