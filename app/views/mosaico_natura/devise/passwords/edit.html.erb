<div id="inscripcion" class="signup-section py-5">
  <%= render partial: "mosaico_natura/shared/sub-header",
             locals: { title: "Cambia tu contraseña" } %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-6">

    <div class="signup-card">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-3">Crear nueva contraseña</h2>

        <p class="text-light opacity-75 mb-0">
          Ingresa una nueva contraseña para proteger tu cuenta y continuar participando en el concurso.
        </p>
      </div>

      <%= simple_form_for(resource,
                          as: resource_name,
                          url: password_path(resource_name),
                          html: { method: :put }) do |f| %>

        <%= f.error_notification %>

        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>

        <div class="form-inputs">

          <%= f.input :password,
                      label: "Nueva contraseña",
                      required: true,
                      autofocus: true,
                      hint: (@minimum_password_length.present? ? "#{@minimum_password_length} caracteres mínimo" : nil),
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

          <%= f.input :password_confirmation,
                      label: "Confirmar nueva contraseña",
                      required: true,
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

        </div>

        <div class="form-actions">
          <%= f.button :submit,
                       "Cambiar mi contraseña",
                       class: "btn btn-success btn-lg w-100 shadow-sm" %>
        </div>

      <% end %>

      <hr class="border-secondary my-4">

      <div class="text-center">
        <%= render "mosaico_natura/devise/shared/links" %>
      </div>

    </div>

  </div>
</div>

  </div>
</div>
