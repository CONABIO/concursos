<div id="inscripcion" class="signup-section max-width">
  <%= render partial: "mosaico_natura/shared/sub-header", locals: { title: "Crear cuenta" } %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-7">

```
    <div class="signup-card">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-3">Únete al concurso</h2>

        <div class="alert alert-info border-0">
          Recuerda, todo concursante deberá crear una cuenta nueva sin importar si ha participado en algún otro concurso anterior.
        </div>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <%= f.error_notification %>

        <div class="form-inputs">

          <%= f.input :email,
                      required: true,
                      label: "Correo electrónico",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "email"
                      } %>

          <%= f.input :password,
                      required: true,
                      label: "Contraseña",
                      hint: ("#{@minimum_password_length} caracteres mínimo" if @minimum_password_length),
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

          <%= f.input :password_confirmation,
                      required: true,
                      label: "Confirmar contraseña",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

        </div>

        <div class="terms-card mt-4 mb-4">

          <div class="form-check">
            <%= f.check_box :terms,
                            class: "form-check-input",
                            required: true %>

            <%= f.label :terms,
                        class: "form-check-label" do %>

              <strong>Acepto los términos y condiciones</strong>

              <div class="small mt-2">
                Bases del concurso:
                <%= link_to "Términos y Condiciones",
                    "https://www.mosaiconatura.net/concursos_assets/mosaico_natura/Termino-y-Condiciones-7oConcursoMosaicoNatura.pdf",
                    target: "_blank" %>

                <br>

                Aviso de privacidad:
                <%= link_to "Consultar aviso",
                    "https://www.mosaiconatura.net/concursos_assets/mosaico_natura/AVISO-DE-PRIVACIDAD-7oConcursoMosaicoNatura.pdf",
                    target: "_blank" %>
              </div>

            <% end %>
          </div>

        </div>

        <%= f.button :submit,
                     "Crear cuenta",
                     class: "btn btn-success btn-lg w-100 shadow-sm" %>

      <% end %>

      <div class="text-center mt-4">
        <%= render "mosaico_natura/devise/shared/links" %>
      </div>

    </div>

  </div>
</div>
```

  </div>
</div>
<style>
.signup-section {
  width: 100%;
  margin: 0;
  padding: 3rem 0;
  background: linear-gradient(
    180deg,
    #0f172a 0%,
    #111827 100%
  );
}

.signup-card {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 24px;
  padding: 1.75rem;
  color: #fff;
  box-shadow: 0 20px 50px rgba(0,0,0,.35);
}

.signup-card .form-control {
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.15);
  background: rgba(255,255,255,.06);
  color: #fff;
}

.signup-card .form-control:focus {
  border-color: #22c55e;
  box-shadow: 0 0 0 .2rem rgba(34,197,94,.2);
}

.terms-card {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  padding: 1rem;
}

.btn-success {
  border-radius: 14px;
  padding: .9rem 1.5rem;
  font-weight: 600;
}

.alert-info {
  border-radius: 14px;
}
</style>
