  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  padding: 1rem;
}

.btn-success {
  border-radius: 14px;
  padding: .9rem 1.5rem;
  font-weight: 600;
}

.alert-info {
  border-radius: 14px;
}
.danger-zone {
  margin-top: 2rem;
  padding: 1.5rem;
