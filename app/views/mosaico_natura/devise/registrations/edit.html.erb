<div id="inscripcion" class="signup-section py-5">
  <%= render partial: "mosaico_natura/shared/sub-header",
             locals: { title: "Modificar cuenta" } %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-7">

```
    <div class="signup-card">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-3">Configuración de la cuenta</h2>

        <p class="text-light opacity-75 mb-0">
          Actualiza tu correo electrónico o cambia tu contraseña de forma segura.
        </p>
      </div>

      <%= simple_form_for(resource,
                          as: resource_name,
                          url: registration_path(resource_name),
                          html: { method: :put }) do |f| %>

        <%= f.error_notification %>

        <div class="form-inputs">

          <%= f.input :email,
                      required: true,
                      autofocus: true,
                      label: "Correo electrónico",
                      input_html: {
                        class: "form-control form-control-lg"
                      } %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="alert alert-warning border-0 mt-3">
              Confirmación pendiente para:
              <strong><%= resource.unconfirmed_email %></strong>
            </div>
          <% end %>

          <%= f.input :password,
                      required: false,
                      label: "Nueva contraseña",
                      hint: "Déjalo vacío si no deseas modificarla.",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

          <%= f.input :password_confirmation,
                      required: false,
                      label: "Confirmar nueva contraseña",
                      hint: "Déjalo vacío si no deseas modificarla.",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "new-password"
                      } %>

          <%= f.input :current_password,
                      required: true,
                      label: "Contraseña actual",
                      hint: "Necesaria para confirmar los cambios.",
                      input_html: {
                        class: "form-control form-control-lg",
                        autocomplete: "current-password"
                      } %>

        </div>

        <div class="form-actions mt-4">
          <%= f.button :submit,
                       "Guardar cambios",
                       class: "btn btn-success btn-lg w-100 shadow-sm" %>
        </div>

      <% end %>

      <div class="danger-zone mt-5">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">

          <div>
            <h5 class="mb-1 text-danger">
              Zona de peligro
            </h5>

            <small class="text-light opacity-75">
              Esta acción eliminará permanentemente tu cuenta y todas tus fotografías.
            </small>
          </div>

          <%= link_to "Eliminar cuenta",
                      registration_path(resource_name),
                      method: :delete,
                      data: {
                        confirm: "Una vez cancelada la cuenta se eliminarán tus datos y fotografías. Esta acción no puede revertirse. ¿Deseas continuar?"
                      },
                      class: "btn btn-outline-danger mt-3 mt-md-0" %>

        </div>

      </div>

    </div>

  </div>
</div>
