<div id="inscripcion" class="bg-dark border-bottom border-light justify-content-center mt-5 pb-5 row">
	<%= render partial: "mosaico_natura/shared/sub-header", locals: { title: "Completa los siguientes datos para completar tu registro:" } %>
	<div class="col-12 col-xl-8 py-4 text-center">
		<% if @registro.persisted? %>
      <%= render 'upload_images', usuario: @registro %>
    <% else %>
      <%= render 'datos_user', usuario: @registro %>
    <% end %>

	</div>
</div>
