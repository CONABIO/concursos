<% nuevo = @registro.new_record? %>
<%= simple_form_for @registro, **@form_params, html: { multipart: true } do |f| %>
  <%= f.error_notification %>
  <% if @registro.errors.any? %> 
    <div class="alert alert-danger"> 
      <h5>No fue posible guardar el registro:</h5> 
      <ul class="mb-0">
        <% @registro.errors.full_messages.each do |message| %> 
          <li><%= message %></li>
        <% end %> 
      </ul> 
    </div>
  <% end %>
    <div class="row mt-4">
    <!-- DATOS DEL CONCURSANTE -->
    <div class="bg-gradient-light col-12 col-lg rounded my-4 px-5 py-3">
      <% unless nuevo %>
        <button type="button"
                class="btn btn-outline-secondary btn-sm fa fa-unlock pull-right rounded rounded-pill"
                onclick="$('#usuario').removeAttr('disabled');$(this).hide();"
                data-toggle="tooltip"
                data-placement="bottom"
                title="Editar los datos de usuario"></button>
      <% end %>
      <h4>Datos del concursante</h4>
      <fieldset id="usuario" class="text-left mb-4"
        <%= 'disabled' unless nuevo %>>
        <%= f.input_field :nombre, class: 'form-control my-2', placeholder: 'Nombre(s)' %>
        <%= f.input_field :apellido_paterno, class: 'form-control my-2', placeholder: 'Apellido paterno' %>
        <%= f.input_field :apellido_materno, class: 'form-control my-2', placeholder: 'Apellido materno' %>
        <label class="my-2 font-weight-bolder"> Fecha de nacimiento (dd/mm/aaaa) </label>
        <%= f.date_field :fecha_nacimiento, min: MosaicoNatura::UsuarioMn::FECHA_NAC_MIN, max: MosaicoNatura::UsuarioMn::FECHA_NAC_MAX, class: 'form-control', title: 'La categoría se determina automáticamente según la fecha de nacimiento' %>
        <div class="alert alert-info mt-3 small">
          <strong>Categorías:</strong>
          <ul class="mb-0">
            <li>
              Nacidos del 06/07/2008 al 05/07/2012:
              <strong>Tema Libre</strong>.
            </li>
            <li>
              Nacidos el 05/07/2008 o antes:
              <strong>Todas las categorías excepto Tema Libre</strong>.
            </li>
          </ul>
        </div>
        <label class="my-2 font-weight-bolder">
          Lugar de nacimiento
        </label>
        <%= f.select :lugar_nacimiento, options_for_select(Direccion::ESTADOS,f.object.lugar_nacimiento),
          {prompt: "--- Seleccionar estado de nacimiento ---"},{ class: 'form-control'} 
        %>
        <label class="my-2 font-weight-bolder">
          ¿Por cuál medio te enteraste del concurso?
        </label>
        <%= f.select :medio, options_for_select(
          MosaicoNatura::UsuarioMn::MEDIO,f.object.medio),
          {prompt: "--- Selecciona ---"},
          {class: 'form-control' } %>
        <%= f.input_field :otro_medio,
          class: 'form-control my-2',placeholder: 'Otro medio (opcional)' %>
        <%= f.hidden_field :user_id, value: current_user_mn.id %>
      </fieldset>
    </div>
    <!-- DIRECCIÓN -->
    <div class="col-lg-1"></div>
    <div class="bg-gradient-light col-12 col-lg rounded my-4 px-5 py-3">
      <% unless nuevo %>
        <button type="button" class="btn btn-outline-secondary btn-sm fa fa-unlock pull-right rounded rounded-pill"
          onclick="$('#direccion').removeAttr('disabled');$(this).hide();"
          data-toggle="tooltip"
          data-placement="bottom"
          title="Editar la dirección"></button>
      <% end %>
      <h4>Dirección</h4>
      <fieldset id="direccion"
        <%= 'disabled' unless nuevo %>>
        <%= f.fields_for :direccion do |direccion_form| %>
          <%= render "mosaico_natura/registro/form_direccion",f: direccion_form %>
        <% end %>
      </fieldset>
    </div>
      <%= f.button :submit, nuevo ? 'Guardar datos' : 'Actualizar datos', class: 'btn btn-success btn-lg btn-block my-4' %>

    </div>
<% end %>
