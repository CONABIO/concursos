
<% categoria = f.object.new_record? ? nombre_categoria : f.object.categoria.nombre_categoria %>

<% maximo =
  case categoria
  when 'cineminuto'
    1
  when 'tema_libre'
    3
  else
    2
  end %>

<div class="col-12 col-lg-6 mb-4 nested-fields nested-fields-for-<%= categoria %>">

  <% if f.object.persisted? %>

    <div class="card shadow-sm">

      <div class="card-body">

        <div class="row align-items-center">

          <div class="col-12 col-md-4 text-center mb-3 mb-md-0">

            <% if categoria == 'cineminuto' %>

              <video controls class="img-fluid rounded">
                <source src="<%= f.object.original_filename.url %>">
              </video>

            <% else %>

              <%= image_tag(
                f.object.original_filename.url,
                class: "img-fluid rounded shadow-sm"
              ) %>

            <% end %>

          </div>

          <div class="col-12 col-md-5">

            <h5 class="text-info mb-3">
              <%= categoria.humanize %>
            </h5>

            <p class="mb-1">
              <strong>Título:</strong>
              <%= f.object.media_metadato&.titulo.presence || "Sin título" %>
            </p>

            <p class="mb-1">
              <strong>Estado:</strong>
              <%= f.object.media_metadato&.localidad.presence || "No especificado" %>
            </p>

          </div>

          <div class="col-12 col-md-3 text-center">

            <button
              type="button"
              class="btn btn-outline-primary btn-sm mb-2 btn-block editar-media">
              Editar
            </button>

            <%= link_to_remove_association(
              "<i class='fa fa-trash'></i> Eliminar".html_safe,
              f,
              class: 'btn btn-outline-danger btn-sm btn-block'
            ) %>

          </div>

        </div>

        <div class="edit-form d-none mt-4">

          <hr>

          <div class="alert alert-info">

            <strong>Editando:</strong>
            <%= categoria.humanize %>

          </div>

          <div class="preview-container text-center mb-3"></div>

          <div class="form-group">

            <label class="font-weight-bold">
              Reemplazar archivo
            </label>

            <%= f.file_field :original_filename,
              accept: categoria == 'cineminuto' ? 'video/mp4' : 'image/png,image/jpeg',
              class: 'form-control file-to-upload' %>

          </div>

          <%= f.hidden_field :categoria_id,
            value: f.object.categoria_id %>

          <div id="media_metadatos" class="row">

            <%= f.simple_fields_for :media_metadato do |media_metadato_form| %>
              <%= render(
                "mosaico_natura/registro/form_media_metadato",
                f: media_metadato_form
              ) %>
            <% end %>

          </div>

        </div>

      </div>

    </div>

  <% else %>

    <div class="rounded shadow p-3 h-100 bg-white">

      <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

          <h5 class="font-weight-bold text-info mb-1">
            📸 <%= categoria.humanize %>
          </h5>

          <small class="text-muted">
            Puedes subir hasta <%= maximo %>
            <%= maximo == 1 ? 'archivo' : 'fotografías' %>
            en esta categoría.
          </small>

        </div>

        <%= link_to_remove_association(
          "<i class='fa fa-trash'></i>".html_safe,
          f,
          class: 'btn btn-outline-danger btn-sm',
          title: 'Eliminar fotografía'
        ) %>

      </div>

      <div class="alert alert-info py-2">

        <strong>Paso 2:</strong>
        Selecciona tu archivo y completa la información requerida.

      </div>

      <div class="preview-container text-center mb-3"></div>

      <div class="form-group">

        <label class="font-weight-bold">
          Archivo
        </label>

        <%= f.file_field :original_filename,
          accept: categoria == 'cineminuto' ? 'video/mp4' : 'image/png,image/jpeg',
          class: 'form-control file-to-upload' %>

      </div>

      <%= f.hidden_field :categoria_id,
        value: categoria_id %>

      <div id="media_metadatos" class="row">

        <% f.object.build_media_metadato if f.object.new_record? %>

        <%= f.simple_fields_for :media_metadato do |media_metadato_form| %>
          <%= render(
            "mosaico_natura/registro/form_media_metadato",
            f: media_metadato_form
          ) %>
        <% end %>

      </div>

    </div>

  <% end %>

</div>
