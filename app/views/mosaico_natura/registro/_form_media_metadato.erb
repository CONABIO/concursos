
<div class="nested-fields col-12">

  <div class="form-group">

    <label class="font-weight-bold">
      Título de la fotografía o video
    </label>

    <%= f.input_field :titulo,
      class: 'form-control',
      placeholder: 'Ejemplo: Colibrí en vuelo' %>

  </div>

  <div class="form-group mt-3">

    <label class="font-weight-bold">
      Historia o descripción
    </label>

    <%= f.text_area :descripcion,
      class: 'form-control',
      rows: 4,
      placeholder: 'Cuéntanos la historia detrás de esta fotografía...' %>

    <small class="form-text text-muted">
      Describe qué aparece en la imagen y por qué es importante.
    </small>

  </div>

  <div class="form-group mt-3">

    <label class="font-weight-bold">
      ¿Cuál es la marca de la cámara utilizada?
    </label>

    <%= f.select :marca,
      options_for_select(
        MosaicoNatura::MediaMetadatoMn::MARCA,
        f.object.marca
      ),
      { prompt: "--- Selecciona la marca de la cámara ---" },
      { class: 'form-control' } %>

  </div>

  <div class="form-group">

    <%= f.input_field :otra_marca,
      class: 'form-control',
      placeholder: 'Otra marca (opcional)' %>

  </div>

  <div class="form-group mt-3">

    <label class="font-weight-bold">
      Estado donde fue tomada la fotografía o video
    </label>

    <%= f.select :localidad,
      options_for_select(
        Direccion::ESTADOS,
        f.object.localidad
      ),
      { prompt: "--- Selecciona el estado ---" },
      { class: 'form-control' } %>

    <small class="form-text text-muted">
      Selecciona el estado de la República Mexicana donde fue capturada.
    </small>

  </div>

</div>
